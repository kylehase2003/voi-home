# Hostinger (Apache/LiteSpeed) config. `_redirects` and `_headers` are
# Netlify-only and ignored here.

# Single-page app: serve real files (assets, sitemap.xml, robots.txt, ...)
# as-is, and send every other path to index.html so React Router can
# render /about, /properties, /property/<slug>, etc.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Hashed build assets never change, so cache them for a year; always
# revalidate index.html so new deploys show up immediately.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
